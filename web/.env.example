# Copy to .env.local for local development, and add the same values in
# Vercel → Project → Settings → Environment Variables.
# Both values are in Supabase → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: shown in the header and footer
NEXT_PUBLIC_HOTEL_NAME=Sample Bay Hotel
NEXT_PUBLIC_HOTEL_ADDRESS=Taguig City, Metro Manila
NEXT_PUBLIC_HOTEL_PHONE=+63 2 8123 4567
